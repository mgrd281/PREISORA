# PREISORA backend — copy to .env (`cp .env.example .env`) and adjust.
# Defaults match docker-compose.yml so the stack works out of the box.

NODE_ENV=development
PORT=3000

# --- Infrastructure -------------------------------------------------------
DATABASE_URL=postgres://preisora:preisora@localhost:5432/preisora
# Isolated database used by `npm run test:e2e` (created/migrated/seeded by the suite).
TEST_DATABASE_URL=postgres://preisora:preisora@localhost:5432/preisora_test
REDIS_URL=redis://localhost:6379
# Separate Redis LOGICAL DB for e2e: the suite flushes it, and the GTIN cache must
# never hand test runs product ids from the dropped dev database.
TEST_REDIS_URL=redis://localhost:6379/1

# --- Auth -----------------------------------------------------------------
# CHANGE BOTH IN ANY NON-LOCAL ENVIRONMENT.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# --- Market defaults (constitution §24) -----------------------------------
# These are the ONLY place 'DE' / 'EUR' may appear. Business logic reads them
# from configuration and never hardcodes a market.
DEFAULT_COUNTRY_CODE=DE
DEFAULT_CURRENCY_CODE=EUR
DEFAULT_LOCALE=de-DE
DEFAULT_TIMEZONE=Europe/Berlin

# --- Price intelligence ---------------------------------------------------
# Freshness window: an observation older than this is no longer `fresh`.
MAX_PRICE_AGE_HOURS=72
# Radius defaults/limits for every geo query (integer meters).
DEFAULT_RADIUS_METERS=5000
MAX_RADIUS_METERS=50000
# Geo lists are capped (ADR-0002).
GEO_RESULT_LIMIT=50
# Short-TTL read-through cache on GET /products/by-gtin/{gtin}.
GTIN_CACHE_TTL_SECONDS=60
# Feature-flag cache TTL.
FEATURE_FLAG_CACHE_TTL_SECONDS=60

# --- Rate limiting (Redis-backed, makes RATE_LIMITED real) ----------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300

# --- Alert engine ---------------------------------------------------------
# Cron is registered unless NODE_ENV=test.
ALERT_ENGINE_CRON=0 */15 * * * *
# Do not re-notify the same alert more often than this.
ALERT_RETRIGGER_COOLDOWN_HOURS=24
