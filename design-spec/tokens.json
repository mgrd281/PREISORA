{
  "$schema": "https://tr.designtokens.org/format/",
  "version": "1.0.0",
  "color": {
    "background": {
      "primary": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "App canvas",
        "$extensions": { "de.preisora.dark": "#0E1116" }
      },
      "secondary": {
        "$type": "color",
        "$value": "#F4F6F8",
        "$description": "Grouped sections, cards on primary",
        "$extensions": { "de.preisora.dark": "#171C23" }
      },
      "elevated": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Sheets, popovers",
        "$extensions": { "de.preisora.dark": "#1E242D" }
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#101418",
        "$extensions": { "de.preisora.dark": "#F2F5F7" }
      },
      "secondary": {
        "$type": "color",
        "$value": "#5B6673",
        "$extensions": { "de.preisora.dark": "#9AA6B2" }
      },
      "onAccent": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$extensions": { "de.preisora.dark": "#FFFFFF" }
      }
    },
    "accent": {
      "primary": {
        "$type": "color",
        "$value": "#0A7D4F",
        "$description": "PREISORA brand green — savings, best price, primary actions",
        "$extensions": { "de.preisora.dark": "#2FB37D" }
      },
      "subtle": {
        "$type": "color",
        "$value": "#E3F3EC",
        "$description": "Accent-tinted fills (best-offer highlight background)",
        "$extensions": { "de.preisora.dark": "#12291F" }
      }
    },
    "success": {
      "$type": "color",
      "$value": "#1E8E3E",
      "$extensions": { "de.preisora.dark": "#4CBB6C" }
    },
    "warning": {
      "$type": "color",
      "$value": "#B26A00",
      "$description": "Aging price data, near-expiry promotions",
      "$extensions": { "de.preisora.dark": "#E0A23E" }
    },
    "error": {
      "$type": "color",
      "$value": "#C4271B",
      "$extensions": { "de.preisora.dark": "#E5675C" }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "#E2E7EC",
        "$extensions": { "de.preisora.dark": "#2A323C" }
      }
    }
  },
  "spacing": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "24px" },
    "xl": { "$type": "dimension", "$value": "32px" }
  },
  "radius": {
    "small": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Chips, badges, small controls"
    },
    "medium": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Cards, list containers — the default PREISORA corner"
    },
    "large": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "Sheets, hero surfaces"
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": { "role": "large-title", "weight": "bold" },
      "$description": "Price hero on product detail. Maps to platform text styles, never fixed px."
    },
    "title": {
      "$type": "typography",
      "$value": { "role": "title-2", "weight": "semibold" },
      "$description": "Screen and section titles"
    },
    "headline": {
      "$type": "typography",
      "$value": { "role": "headline", "weight": "semibold" },
      "$description": "Card headlines, offer retailer names"
    },
    "body": {
      "$type": "typography",
      "$value": { "role": "body", "weight": "regular" }
    },
    "caption": {
      "$type": "typography",
      "$value": { "role": "footnote", "weight": "regular" },
      "$description": "Freshness stamps, distances, legal"
    },
    "price": {
      "$type": "typography",
      "$value": { "role": "title-1", "weight": "bold", "numericStyle": "monospaced-digits" },
      "$description": "All price figures use monospaced digits so lists align"
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "150ms",
        "$description": "Micro-feedback: taps, toggles"
      },
      "standard": {
        "$type": "duration",
        "$value": "250ms",
        "$description": "Screen-level transitions, list changes"
      },
      "emphasized": {
        "$type": "duration",
        "$value": "400ms",
        "$description": "Scan-success → product-resolved moment"
      }
    },
    "$description": "Philosophy: motion confirms intelligence (a price arriving, a scan resolving) — never decorates. Respect platform reduce-motion settings unconditionally."
  }
}
